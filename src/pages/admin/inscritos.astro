---
import Layout from "../../components/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { siWhatsapp } from "simple-icons";
import { crearControladores } from "../../modulos/infraestructura/contenedor";
import { sesionAdministrativaValida } from "../../modulos/infraestructura/http/AutenticacionAdministrativa";

if (!sesionAdministrativaValida(Astro.request)) {
  return Astro.redirect("/admin/login", 303);
}

const inscritos = await crearControladores().inscripciones.listar();
const pagados = inscritos.filter((inscrito) => inscrito.estado === "pagada");
const pendientes = inscritos.filter(
  (inscrito) => inscrito.estado === "pendiente_pago",
);
const estudiantes = inscritos.filter(
  (inscrito) => inscrito.tipoParticipante === "estudiante",
);
const generales = inscritos.filter(
  (inscrito) => inscrito.tipoParticipante === "general",
);
const recaudacion = pagados.reduce(
  (total, inscrito) => total + inscrito.montoInscripcion,
  0,
);
function fecha(fechaIso: string) {
  return new Intl.DateTimeFormat("es-BO", {
    dateStyle: "short",
  }).format(new Date(fechaIso));
}

function hora(fechaIso: string) {
  return new Intl.DateTimeFormat("es-BO", {
    timeStyle: "short",
  }).format(new Date(fechaIso));
}

function tipo(tipoParticipante: string) {
  return tipoParticipante === "estudiante" ? "EST" : "GEN";
}

function enlaceWhatsApp(numero: string) {
  const numeroNormalizado = numero.replace(/\D/g, "");
  const numeroInternacional = numeroNormalizado.startsWith("591")
    ? numeroNormalizado
    : `591${numeroNormalizado}`;
  return `https://wa.me/${numeroInternacional}`;
}

function estado(estadoInscripcion: string) {
  return estadoInscripcion === "pagada"
    ? "Pagada"
    : estadoInscripcion === "cancelada"
      ? "Cancelada"
      : "Pendiente";
}
---

<Layout
  title="Consulta de inscritos · Infosis Build Fest 2026"
  description="Consulta privada de participantes inscritos en Infosis Build Fest 2026."
  mostrarModal={false}
>
  <Navbar />
  <main id="contenido" class="admin-page">
    <div class="admin-shell">
      <header class="admin-header">
        <div>
          <p class="eyebrow">PANEL DE PARTICIPANTES</p>
          <h1>Consulta de inscritos</h1>
        </div>
        <form action="/admin/logout" method="post">
          <button class="button" type="submit">Cerrar sesión</button>
        </form>
      </header>

      <section class="summary" aria-label="Resumen de inscripciones">
        <article><span>Total</span><strong>{inscritos.length}</strong></article>
        <article><span>Pagadas</span><strong>{pagados.length}</strong></article>
        <article>
          <span>Pendientes</span><strong>{pendientes.length}</strong>
        </article>
        <article>
          <span>Estudiantes</span><strong>{estudiantes.length}</strong>
        </article>
        <article>
          <span>Generales</span><strong>{generales.length}</strong>
        </article>
        <article>
          <span>Recaudación</span><strong>{recaudacion.toFixed(2)} Bs</strong>
        </article>
      </section>

      <section class="table-card" aria-labelledby="listado-title">
        <div class="table-heading">
          <div>
            <h2 id="listado-title">Lista completa</h2>
          </div>
        </div>

        {
          inscritos.length === 0 ? (
            <p class="empty-state">Todavía no hay inscritos registrados.</p>
          ) : (
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Participante</th>
                    <th>CI</th>
                    <th>WhatsApp</th>
                    <th>Código</th>
                    <th>Registro</th>
                    <th>Laptop</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                  </tr>
                </thead>
                <tbody>
                  {inscritos.map((inscrito) => (
                    <tr>
                      <td data-label="Participante">
                        <strong>{inscrito.nombreCompleto}</strong>
                      </td>
                      <td data-label="CI">{inscrito.ci}</td>
                      <td data-label="WhatsApp">
                        <a
                          class="whatsapp-link"
                          href={enlaceWhatsApp(inscrito.whatsapp)}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`Abrir WhatsApp de ${inscrito.nombreCompleto}`}
                        >
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d={siWhatsapp.path} />
                          </svg>
                          <span>{inscrito.whatsapp}</span>
                        </a>
                      </td>
                      <td data-label="Código">
                        <span
                          title={
                            inscrito.tipoParticipante === "estudiante"
                              ? "Estudiante"
                              : "General"
                          }
                        >
                          {tipo(inscrito.tipoParticipante)}
                        </span>
                      </td>
                      <td data-label="Registro">
                        {inscrito.registroEstudiante ?? "—"}
                      </td>
                      <td data-label="Laptop">
                        {inscrito.llevaLaptop ? "Sí" : "No"}
                      </td>
                      <td data-label="Estado">
                        <span
                          class:list={{
                            badge: true,
                            paid: inscrito.estado === "pagada",
                            pending: inscrito.estado === "pendiente_pago",
                            cancelled: inscrito.estado === "cancelada",
                          }}
                        >
                          {estado(inscrito.estado)}
                        </span>
                      </td>
                      <td data-label="Fecha">
                        <div class="fecha-dato">
                          <span>{fecha(inscrito.creadoEn)}</span>
                          <small>{hora(inscrito.creadoEn)}</small>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    min-width: 320px;
    background: var(--bg);
    color: var(--text);
  }
  .admin-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 90% 0%, #147db51c, transparent 35%), var(--bg);
  }
  .admin-shell {
    width: 100%;
    max-width: var(--shell);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter);
  }
  .admin-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--violet);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1,
  h2 {
    margin: 0;
  }
  h1 {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 400;
  }
  h2 {
    font-size: 1.1rem;
    font-weight: 400;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .summary article {
    min-height: 6.5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .summary span {
    display: block;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .summary strong {
    display: block;
    margin-top: 0.8rem;
    color: var(--violet);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
  }
  .table-card {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--surface-hover);
  }
  .table-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  th:nth-child(1),
  td:nth-child(1) {
    width: 26%;
  }
  th:nth-child(2),
  td:nth-child(2) {
    width: 10%;
  }
  th:nth-child(3),
  td:nth-child(3) {
    width: 15%;
  }
  th:nth-child(4),
  td:nth-child(4) {
    width: 8%;
  }
  th:nth-child(5),
  td:nth-child(5) {
    width: 13%;
  }
  th:nth-child(6),
  td:nth-child(6) {
    width: 8%;
  }
  th:nth-child(7),
  td:nth-child(7) {
    width: 10%;
  }
  th:nth-child(8),
  td:nth-child(8) {
    width: 10%;
  }
  th,
  td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid #ffffff0e;
    text-align: left;
    overflow-wrap: anywhere;
    font-size: 0.75rem;
  }
  th {
    color: var(--violet);
    background: #ffffff08;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  td strong {
    color: var(--text);
  }
  td small {
    display: block;
    margin-top: 0.25rem;
    color: var(--dim);
  }
  .whatsapp-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    color: #72e0ab;
    font-size: 0.68rem;
  }
  .whatsapp-link:hover {
    color: #9af0c5;
  }
  .whatsapp-link svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: currentColor;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .badge {
    display: inline-block;
    border-radius: 99px;
    padding: 0.3rem 0.5rem;
    font-size: 0.62rem;
  }
  .paid {
    background: #42c98b22;
    color: #72e0ab;
  }
  .pending {
    background: #e5aa4222;
    color: #f0c36f;
  }
  .cancelled {
    background: #c51d2a22;
    color: #ff9090;
  }
  .empty-state {
    margin: 0;
    padding: 3rem 1.25rem;
    color: var(--muted);
    text-align: center;
    font-size: 0.8rem;
  }
  @media (max-width: 560px) {
    .admin-shell {
      padding-block: 2rem;
    }
    .admin-header {
      align-items: start;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .admin-header .button {
      align-self: flex-start;
      min-width: 10rem;
    }
    .summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .summary article {
      min-height: 5.5rem;
      padding: 0.65rem 0.45rem;
    }
    .summary span {
      font-size: 0.55rem;
    }
    .summary strong {
      margin-top: 0.65rem;
      font-size: 1rem;
      line-height: 1.2;
    }
    .table-scroll {
      overflow-x: visible;
    }
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    tbody tr {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--line);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    td {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100% !important;
      padding: 0.45rem 0;
      border-bottom: 0;
      text-align: right;
    }
    td::before {
      flex: 0 0 auto;
      color: var(--muted);
      content: attr(data-label);
      font-size: 0.62rem;
      text-align: left;
    }
    td[data-label="Participante"] {
      display: block;
      text-align: left;
    }
    td[data-label="Participante"]::before {
      display: block;
      margin-bottom: 0.25rem;
    }
    td[data-label="WhatsApp"] {
      align-items: flex-start;
    }
    .whatsapp-link {
      justify-content: flex-end;
    }
    .table-heading {
      align-items: start;
      flex-direction: column;
      padding: 1rem;
    }
    td[data-label="Participante"] strong {
      display: block;
      font-size: 0.8rem;
      line-height: 1.4;
    }
    .fecha-dato {
      text-align: right;
    }
    .whatsapp-link {
      max-width: 65%;
      overflow-wrap: anywhere;
    }
  }
  @media (max-width: 360px) {
    .admin-shell {
      padding-inline: 1rem;
    }
    .summary span {
      font-size: 0.5rem;
    }
    .summary strong {
      font-size: 0.9rem;
    }
  }
</style>
