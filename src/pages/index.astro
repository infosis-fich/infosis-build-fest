---
export const prerender = true;

import Layout from "../components/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import EventInfo from "../components/EventInfo.astro";
import Tracks from "../components/Tracks.astro";
import Agenda from "../components/Agenda.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout image="/portada.png"
  ><Navbar /><main id="contenido">
    <Hero /><EventInfo /><Tracks /><Agenda /><FinalCta />
  </main><Footer /></Layout
>
<script>
  import { initScrollAnimations } from "../scripts/scroll-animations";
  initScrollAnimations();
</script>
