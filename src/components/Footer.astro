---
import { siGithub, siTiktok, siWhatsapp } from "simple-icons";
import { event } from "../data/event";
---

<footer class="footer shell">
  <b class="footer__title">Más información</b>
  <nav class="footer-links" aria-label="Enlaces de contacto y redes">
    <a href={event.contact.whatsapp} target="_blank" rel="noreferrer"
      ><span class="footer-link__icon" aria-hidden="true"
        ><svg viewBox="0 0 24 24"><path d={siWhatsapp.path}></path></svg></span
      > WhatsApp</a
    ><a href={event.contact.github} target="_blank" rel="noreferrer"
      ><span class="footer-link__icon" aria-hidden="true"
        ><svg viewBox="0 0 24 24"><path d={siGithub.path}></path></svg></span
      > Código fuente · MIT</a
    ><a href={event.contact.tiktok} target="_blank" rel="noreferrer"
      ><span class="footer-link__icon" aria-hidden="true"
        ><svg viewBox="0 0 24 24"><path d={siTiktok.path}></path></svg></span
      > TikTok</a
    >
  </nav>
  <p class="footer__credit">
    Hecho con <span aria-label="amor">❤</span> por{" "}
    <a href="https://github.com/feresdev" target="_blank" rel="noreferrer"
      >feresdev</a
    >
  </p>
</footer>
