---
import "../styles/global.css";
import BackToTop from "./BackToTop.astro";
import ModalInscripcion from "./ModalInscripcion.astro";
import { event } from "../data/event";

const {
  title = `${event.title} · Inscríbete ahora`,
  description = event.seoDescription,
  image = "/portada.png",
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const socialImage = new URL(image, Astro.url);
---

<html lang="es">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#101014"
    /><link rel="canonical" href={canonical} /><meta
      property="og:type"
      content="website"
    /><meta property="og:locale" content="es_AR" /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:image"
      content={socialImage}
    /><meta property="og:image:alt" content="Infosis Build Fest 2026" /><meta
      name="twitter:card"
      content="summary_large_image"
    /><meta name="twitter:title" content={title} /><meta
      name="twitter:description"
      content={description}
    /><meta name="twitter:image" content={socialImage} /><link
      rel="icon"
      href="/ico-infosis-transparent.png"
      type="image/png"
    /><link
      rel="shortcut icon"
      href="/ico-infosis-transparent.png"
      type="image/png"
    /><title>
      {title}
    </title></head
  ><body><slot /><BackToTop /><ModalInscripcion /></body>
</html>
