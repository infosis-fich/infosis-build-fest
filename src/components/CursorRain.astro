<canvas class="hero__cursor-rain" data-cursor-rain aria-hidden="true"></canvas>

<script>
  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    size: number;
    color: string;
  };

  const canvases =
    document.querySelectorAll<HTMLCanvasElement>("[data-cursor-rain]");

  canvases.forEach((canvas) => {
    const hero = canvas.closest<HTMLElement>(".hero, .cta--hero");
    if (!hero) return;
    const context = canvas.getContext("2d");
    const particles: Particle[] = [];
    const colors = ["#c9e9f5", "#8fd0e9", "#4da9d4", "#147db5"];
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let frame = 0;
    let pointer = { x: 0, y: 0, active: false };

    const resize = () => {
      const bounds = hero.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(bounds.width * dpr));
      canvas.height = Math.max(1, Math.round(bounds.height * dpr));
      canvas.style.width = `${bounds.width}px`;
      canvas.style.height = `${bounds.height}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const addParticles = () => {
      if (!pointer.active) return;
      for (let index = 0; index < 7; index += 1) {
        particles.push({
          x: pointer.x + (Math.random() - 0.5) * 70,
          y: pointer.y + (Math.random() - 0.5) * 55,
          vx: (Math.random() - 0.5) * 1.3,
          vy: Math.random() * 1.8 + 0.4,
          life: 1,
          size: Math.random() * 2.5 + 2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
    };

    const render = () => {
      if (!context) return;
      const width = hero.clientWidth;
      const height = hero.clientHeight;
      context.clearRect(0, 0, width, height);
      addParticles();

      for (let index = particles.length - 1; index >= 0; index -= 1) {
        const particle = particles[index];
        particle.x += particle.vx;
        particle.y += particle.vy;
        particle.life -= 0.018;
        if (particle.life <= 0 || particle.y > height + 20) {
          particles.splice(index, 1);
          continue;
        }
        context.globalAlpha = particle.life * 0.7;
        context.fillStyle = particle.color;
        context.fillRect(
          Math.round(particle.x),
          Math.round(particle.y),
          particle.size,
          particle.size,
        );
      }
      context.globalAlpha = 1;

      if (!reducedMotion || particles.length)
        frame = requestAnimationFrame(render);
    };

    hero.addEventListener("pointermove", (event) => {
      const bounds = hero.getBoundingClientRect();
      pointer = {
        x: event.clientX - bounds.left,
        y: event.clientY - bounds.top,
        active: true,
      };
      if (!reducedMotion && !frame) frame = requestAnimationFrame(render);
    });
    hero.addEventListener("pointerleave", () => {
      pointer.active = false;
    });
    window.addEventListener("resize", resize);
    resize();
  });
</script>
