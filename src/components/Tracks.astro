---
import { event } from "../data/event";
import PixelCard from "./PixelCard.astro";
---

<section class="section" id="herramientas" data-reveal>
  <div class="shell">
    <div class="section__head">
      <h2 class="section__title">Qué vas a aprender</h2>
      <p class="section__sub">
        {event.copy.learningIntro}
      </p>
    </div>
    <div class="cards">
      {
        event.tracks.map(([, title, description]) => {
          const [name] = title.split(" · ");
          return <PixelCard title={name} description={description} />;
        })
      }
    </div>
  </div>
</section>
