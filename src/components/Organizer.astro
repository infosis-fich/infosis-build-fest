---
import { event } from "../data/event";
---

<div class="sponsors" data-reveal aria-label="Organización del evento">
  <div class="shell sponsors-inner">
    <h2 class="sponsors__title">Organiza</h2><ul class="sponsors__list">
      <li class="organizer">
        <img
          class="organizer__logo"
          src="/ico-infosis-transparent.png"
          alt=""
          width="48"
          height="48"
        /><strong>
          {
            event.organizers[0]
              .split(" y ")
              .map((line, index) => (
                <span>{index === 0 ? line : `y ${line}`}</span>
              ))
          }
        </strong>
      </li>
    </ul>
  </div>
</div>
