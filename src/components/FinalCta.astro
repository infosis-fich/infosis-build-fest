---
import { event } from "../data/event";
import CursorRain from "./CursorRain.astro";
---

<section class="section cta-section cta--hero" id="inscripcion" data-reveal>
  <CursorRain /><div class="shell">
    <div class="cta__content">
      <p class="cta__eyebrow">INSCRIPCIÓN</p><h2 class="cta__title">
        Construye el futuro
      </h2><p class="cta__body">
        Forma parte de dos días de aprendizaje práctico, colaboración y
        desarrollo con agentes de IA. El costo de inscripción es de <strong
          >30 Bs</strong
        >.
      </p><a class="button primary" href={event.registrationUrl} data-registration-trigger
        >→ Inscribirme ahora</a>
    </div>
  </div>
</section>
