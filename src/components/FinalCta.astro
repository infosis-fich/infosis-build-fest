---
import { event } from "../data/event";
import CursorRain from "./CursorRain.astro";
---

<section class="section cta-section cta--hero" id="inscripcion" data-reveal>
  <CursorRain /><div class="shell">
    <div class="cta__content">
      <p class="cta__eyebrow">INSCRIPCIÓN</p><h2 class="cta__title">
        {event.copy.tituloInscripcion}
      </h2><p class="cta__body">
        {event.copy.introduccionInscripcion}
      </p>
      <ul class="cta__benefits">
        {event.benefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
      <a
        class="button primary"
        href={event.urlInscripcion}
        data-disparador-inscripcion>→ Inscribirme ahora</a
      >
      <div class="cta-pricing" aria-label="Precios de inscripción">
        {
          event.pricing.map(([audience, price]) => (
            <div class="cta-pricing__item">
              <span>{audience}</span>
              <strong>{price}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
