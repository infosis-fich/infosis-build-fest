---
import { siGithub, siTiktok, siWhatsapp } from "simple-icons";
import { event } from "../data/event";

const esInicio = Astro.url.pathname === "/";
---

<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="shell nav-inner">
    <a
      class="brand"
      href={esInicio ? "#inicio" : "/"}
      aria-label="Infosis Build Fest, inicio"
      ><img
        class="brand-logo"
        src="/ico-infosis-transparent.png"
        alt="Logo de Ingeniería Informática y Sistemas"
        width="34"
        height="34"
      /></a
    >
    <a class="brand-home" href={esInicio ? "#inicio" : "/"}>Inicio</a>
    {
      esInicio && (
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          <>
            <span class="sr-only">Abrir menú</span>
            <span aria-hidden="true">☰</span>
          </>
        </button>
      )
    }
    {
      esInicio && (
        <nav id="main-navigation" aria-label="Navegación principal">
          <>
            <a href="#que-es">¿Qué es?</a>
            <a href="#aprendizaje">Aprendizaje</a>
            <a href="#agenda">Agenda</a>
            <a href="#participa">Participa</a>
          </>
        </nav>
      )
    }
    {
      !esInicio && (
        <div class="header-socials" aria-label="Contacto y redes">
          <a
            href={event.contact.whatsapp}
            target="_blank"
            rel="noreferrer"
            aria-label="Más información por WhatsApp"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={siWhatsapp.path} />
            </svg>
          </a>
          <a
            href={event.contact.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub de Infosis"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={siGithub.path} />
            </svg>
          </a>
          <a
            href={event.contact.tiktok}
            target="_blank"
            rel="noreferrer"
            aria-label="TikTok de Infosis"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={siTiktok.path} />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#main-navigation");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
  });
  nav?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    }),
  );
</script>
